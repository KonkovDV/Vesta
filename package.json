  "scripts": {
    "build": "node ./node_modules/@typescript/native/bin/tsc --build tsconfig.build.json --pretty false && node scripts/copy-migrations.cjs && node scripts/rewrite-dist-aliases.cjs",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json",
    "prepare": "node scripts/prepare-kernel.cjs",
    "start": "node dist/index.js",
    "migrate": "node dist/infrastructure/database/migrate-cli.js"

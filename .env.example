# MicroPhoenix Environment Variables
# Copy to .env and fill in real values before running docker-compose
# NEVER commit .env to version control

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=microphoenix
# Matches docker-compose.yml host port 5432. Do not commit a real password.
DATABASE_URL=postgresql://postgres:CHANGE_ME_strong_password_here@127.0.0.1:5432/microphoenix

# ── Redis ──────────────────────────────────────────────────────────
# Leave empty to run without auth (dev only) or set a strong password
REDIS_PASSWORD=
# Matches docker-compose.yml host port 6379. If REDIS_PASSWORD is set, include it in the URL.
REDIS_URL=redis://127.0.0.1:6379

# ── HTTP ───────────────────────────────────────────────────────────
ENABLE_HTTP=true
# REQUIRED before a real HTTP listener: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── OpenMemory ─────────────────────────────────────────────────────
# Use a cryptographically random value: `openssl rand -hex 32`
OM_API_KEY=CHANGE_ME_random_api_key

# ── Neo4j ──────────────────────────────────────────────────────────
NEO4J_PASSWORD=CHANGE_ME_strong_neo4j_password

# ── OpenAI ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── OpenClaw ───────────────────────────────────────────────────────
OPENCLAW_API_KEY=
OPENCLAW_STATE_DIR=
OPENCLAW_MEMORY_LIMIT=512
OPENCLAW_CPU_LIMIT=50
# REQUIRED: comma-separated explicit domains agents may contact.
# Leaving this empty will cause OpenClawNativeBridge to refuse spawning agents.
# Example: OPENCLAW_ALLOWED_DOMAINS=api.github.com,api.openai.com,registry.npmjs.org
OPENCLAW_ALLOWED_DOMAINS=api.github.com

# ── Kernel switches (2.10.0) ───────────────────────────────────────
# Standard plugins to load: comma-separated directory names, or * . Empty loads none.
STANDARD_PLUGINS=
# Fail a Redis PUBLISH that reached no subscriber, so the outbox retries it.
EVENT_BUS_REQUIRE_SUBSCRIBER=false
# Accept api_key in the query string (never in production).
ALLOW_QUERY_API_KEY=false
# API keys. Only the JSON list can carry scopes. BFF_API_KEY and BFF_API_KEYS_CSV
# create keys with an empty scope list, so sales, hr, healthcare, and ingest answer 403.
# BFF_API_KEYS=[{"key":"CHANGE_ME","userId":"operator","scopes":["sales.use"]}]
BFF_API_KEY=
BFF_API_KEYS_CSV=
BFF_API_KEYS=
# Express trust proxy setting behind a load balancer, e.g. 1 or loopback.
TRUST_PROXY=
# Tools that wait for a person (names or group:x). Unset = kernel default list; empty = never ask.
# TOOL_APPROVAL_REQUIRED=exec,write,edit,apply_patch,group:messaging,send_message,browser,fs_write_file
# Provider model ids for the agent loop.
ANTHROPIC_MODEL=
OPENAI_MODEL=

# ── App ────────────────────────────────────────────────────────────
# Set to false in production to use real LLM
USE_MOCK_AI=true

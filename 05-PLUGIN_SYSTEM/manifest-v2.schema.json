{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microphoenix.dev/schema/manifest-v2.schema.json",
  "title": "MicroPhoenix Plugin Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_ms": {
          "type": "integer",
          "minimum": 0
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 0
        },
        "gpu_ms": {
          "type": "integer",
          "minimum": 0
        },
        "network_kb": {
          "type": "integer",
          "minimum": 0
        },
        "storage_mb": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "profile",
    "identity",
    "entrypoints",
    "actions",
    "capabilities",
    "budgets",
    "security"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "v2"
    },
    "kind": {
      "type": "string",
      "const": "plugin",
      "description": "Resource kind. For plugin manifests this must always be \"plugin\"."
    },
    "profile": {
      "type": "string",
      "description": "Manifest profile that controls required blocks and validation strictness.",
      "enum": [
        "minimal",
        "standard",
        "restricted"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "category",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "ownership_type"
      ],
      "properties": {
        "vendor": {
          "type": "string",
          "description": "Legal or organizational owner of the plugin."
        },
        "ownership_type": {
          "type": "string",
          "description": "Ownership classification of the plugin.",
          "enum": [
            "first_party",
            "partner",
            "community",
            "customer_internal"
          ]
        },
        "contact_email": {
          "type": "string",
          "format": "email",
          "description": "Operational contact for security and incident response."
        }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": {
          "type": "string",
          "description": "Trust tier according to Plugin Trust Policy.",
          "enum": [
            "internal",
            "trusted_partner",
            "verified",
            "unverified",
            "high_risk"
          ]
        },
        "risk_level": {
          "type": "string",
          "description": "Overall risk level of the plugin.",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "sandbox_mode": {
          "type": "string",
          "description": "Sandbox/runtime profile used for this plugin.",
          "enum": [
            "sandbox_wasm",
            "sandbox_subprocess",
            "container",
            "serverless",
            "edge_device"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugin_type": {
          "type": "string",
          "description": "High-level runtime integration type.",
          "enum": [
            "native",
            "http",
            "mcp",
            "worker"
          ]
        },
        "runtime_profile": {
          "type": "string",
          "description": "Runtime profile; usually aligned with trust.sandbox_mode."
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "cmd"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "enum": [
            "subprocess",
            "container",
            "wasm"
          ]
        },
        "cmd": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compat": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "input_schema_ref",
          "output_schema_ref"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "input_schema_ref": {
            "type": "string",
            "description": "Reference to JSON Schema describing action input."
          },
          "output_schema_ref": {
            "type": "string",
            "description": "Reference to JSON Schema describing action output."
          },
          "policy_action": {
            "type": "string",
            "description": "Logical PolicyEngine action identifier for this operation."
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "egress_allow": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "hostname"
              }
            },
            "ingress": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "env_allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pii_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "residency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "denied_regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "managed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_systems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_residency": {
          "type": "string"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "object",
          "description": "Arbitrary policy tags as defined in POLICY_ENGINE_ARCH_SPEC.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "required_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "governance_hooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pre_call": {
              "type": "boolean"
            },
            "post_call": {
              "type": "boolean"
            },
            "on_violation": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signatures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fingerprints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attestation_claims": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "format": {
          "type": "string",
          "enum": [
            "spdx",
            "cyclonedx"
          ]
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "extended"
          ]
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emits": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "consumes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "compliance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "update_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "stable",
            "beta",
            "canary"
          ]
        },
        "min_sdk": {
          "type": "string"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "estimated_unit_usd": {
          "type": "number",
          "minimum": 0
        },
        "billing_tag": {
          "type": "string"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budgets": {
          "$ref": "#/$defs/budgets"
        },
        "rate_limits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "unit",
              "limit"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "unit": {
                "type": "string",
                "enum": [
                  "per_minute",
                  "per_hour",
                  "per_day",
                  "concurrent"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1
              },
              "burst": {
                "type": "integer",
                "minimum": 1
              },
              "window_seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_url": {
          "type": "string",
          "format": "uri"
        },
        "server_url": {
          "type": "string",
          "format": "uri"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "x_extensions": {
      "type": "object",
      "description": "Forward-compatible extension point for additional, non-standard fields.",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "standard"
          }
        }
      },
      "then": {
        "required": [
          "owner",
          "trust",
          "policy",
          "telemetry",
          "security"
        ],
        "properties": {
          "owner": {
            "required": [
              "vendor",
              "ownership_type",
              "contact_email"
            ]
          },
          "actions": {
            "items": {
              "required": [
                "name",
                "description",
                "input_schema_ref",
                "output_schema_ref",
                "policy_action"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "restricted"
          }
        }
      },
      "then": {
        "required": [
          "owner",
          "trust",
          "policy",
          "telemetry",
          "security",
          "cost",
          "limits"
        ],
        "properties": {
          "owner": {
            "required": [
              "vendor",
              "ownership_type",
              "contact_email"
            ]
          },
          "trust": {
            "required": [
              "risk_level"
            ]
          },
          "actions": {
            "items": {
              "required": [
                "name",
                "description",
                "input_schema_ref",
                "output_schema_ref",
                "policy_action"
              ]
            }
          }
        }
      }
    }
  ]
}